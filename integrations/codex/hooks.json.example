{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh '/Users/hemu/Desktop/github/CodexMemoryOS/knowledge-base/user-prompt-submit.sh'",
            "timeout": 10,
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [{ "type": "command", "command": "/bin/sh '/Users/hemu/Desktop/github/CodexMemoryOS/integrations/codex/capture-hook.sh'", "timeout": 1 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "/bin/sh '/Users/hemu/Desktop/github/CodexMemoryOS/integrations/codex/capture-hook.sh'", "timeout": 1 }]
      }
    ]
  }
}
