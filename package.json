{
  "name": "@codex-memory-os/root",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.16.0",
    "pnpm": "11.1.3"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --recursive --parallel --if-present dev",
    "dev:hub": "pnpm --filter @codex-memory-os/hub dev",
    "dev:server": "pnpm --filter @codex-memory-os/server dev",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  }
}

